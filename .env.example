# Environment configuration. Copy to .env and edit if you want live LLM extraction.
# The competition pipeline works fully without an API key using the deterministic extractor.

PROCUREMENT_ENV=acme

# Extraction policy: auto | deterministic | llm
# auto = deterministic extraction, LLM only for unresolved/ambiguous cases when configured.
EXTRACTION_MODE=deterministic

# Provider-independent OpenAI-compatible endpoint. No keys are committed to this repository.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0

# Retrieval
RETRIEVAL_TOP_K=8
RETRIEVAL_RRF_K=60
RETRIEVAL_USE_RERANKER=true
RETRIEVAL_EMBEDDING_BACKEND=hash
RETRIEVAL_EMBEDDING_DIM=512

# Runtime
RUN_ID=
ENABLE_CHECKPOINTS=false
LOG_LEVEL=INFO
